// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TargetAudience {
  end_user
  admin
  developer
  mixed
}

enum PipelineStage {
  ingested
  analyzing
  restructuring
  validating
  ready
  failed
}

enum Confidence {
  high
  medium
  low
}

enum SnapshotType {
  raw
  converted
  enriched
}

enum FindingType {
  outdated
  incomplete
  image_dependent
  no_resolution_steps
  too_vague
  audience_mismatch
  missing_prerequisites
  no_error_guidance
  missing_context
  unlinked_product
  broken_link
  duplicate
}

enum Severity {
  high
  medium
  low
}

enum FindingState {
  new
  acknowledged
  remediated
  cancelled
}

enum ProductType {
  internal
  external
  vendor
  platform
}

enum JobStatus {
  pending
  running
  completed
  completed_with_errors
  failed
}

enum JobItemStatus {
  pending
  converting
  analyzing
  enriching
  scoring
  completed
  failed
  skipped
}

enum ContentFormat {
  md
  html
  csv
  json
  text
}

enum ImportStatus {
  pending
  running
  completed
  completed_with_errors
  failed
}

enum ConnectorType {
  rest_json
  url_crawl
}

// ---------------------------------------------------------------------------
// Ingestion: where articles and incidents come from
// ---------------------------------------------------------------------------

/// A configured external source that is pulled on a schedule.
model DataSource {
  id          String        @id @default(cuid())
  name        String
  type        ConnectorType
  config      Json          @default("{}")
  cron        String? // null = manual pull only
  enabled     Boolean       @default(true)
  lastRunAt   DateTime?
  lastStatus  ImportStatus?
  lastMessage String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  articles   Article[]
  importRuns ImportRun[]
}

/// One upload or one scheduled pull. Groups the records it created.
model ImportRun {
  id           String       @id @default(cuid())
  dataSourceId String?
  label        String // file name(s) or source name
  status       ImportStatus @default(pending)
  total        Int          @default(0)
  created      Int          @default(0)
  updated      Int          @default(0)
  skipped      Int          @default(0)
  errors       Json         @default("[]")
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?

  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  articles   Article[]
  incidents  Incident[]
}

/// A source KB article. Replaces ServiceNow kb_knowledge.
model Article {
  id              String        @id @default(cuid())
  externalId      String? // id in the originating system, for upsert on re-import
  title           String
  body            String // original content, in `format`
  format          ContentFormat @default(md)
  knowledgeBase   String?
  url             String?
  metadata        Json          @default("{}")
  sourceUpdatedAt DateTime? // article's own last-modified time, enables skip-on-rerun
  dataSourceId    String?
  importRunId     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  dataSource DataSource? @relation(fields: [dataSourceId], references: [id], onDelete: SetNull)
  importRun  ImportRun?  @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  analysis   Analysis?
  jobItems   JobItem[]
  chunks     Chunk[]

  @@unique([dataSourceId, externalId])
  @@index([knowledgeBase])
}

/// A support incident used as evidence when enriching an article.
model Incident {
  id               String    @id @default(cuid())
  number           String    @unique
  shortDescription String
  description      String    @default("")
  resolution       String    @default("")
  category         String?
  openedAt         DateTime?
  importRunId      String?
  createdAt        DateTime  @default(now())

  importRun ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  evidence  Evidence[]
}

// ---------------------------------------------------------------------------
// Pipeline
// ---------------------------------------------------------------------------

/// One row per article, holding its current pipeline state.
/// Content and scores live in Snapshot, not here.
model Analysis {
  id                   String          @id @default(cuid())
  articleId            String          @unique
  sourceUpdatedAt      DateTime? // article's updatedAt at last processing
  standardizedSummary  String?
  searchTerms          Json            @default("[]") // up to 8 user-facing terms
  targetAudience       TargetAudience?
  pipelineStage        PipelineStage   @default(ingested)
  enrichmentConfidence Confidence?
  enrichmentKnowledge  Json? // Call 2 output, read back by Call 3
  lastJobId            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  article   Article    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  lastJob   Job?       @relation("AnalysisLastJob", fields: [lastJobId], references: [id], onDelete: SetNull)
  snapshots Snapshot[]
  findings  Finding[]
  mentions  Mention[]
  jobItems  JobItem[]

  duplicateOf       Finding[] @relation("FindingRelated")
  primaryFor        Finding[] @relation("FindingPrimary")
  dedicatedProducts Product[] @relation("ProductDedicated")

  @@index([pipelineStage])
}

/// Append-only content version per (article, stage) per pipeline run.
/// `version` ties one run's raw/converted/enriched trio together.
model Snapshot {
  id                String       @id @default(cuid())
  analysisId        String
  type              SnapshotType
  version           Int
  content           String
  score             Int? // mechanical score, 0-100
  llmScore          Int? // LLM quality score, 0-100
  wordCount         Int?
  tokenCount        Int?
  imageCount        Int?
  linkCount         Int?
  brokenLinkCount   Int?
  processingMessage String?
  processedAt       DateTime?
  lastJobId         String?
  createdAt         DateTime     @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  lastJob  Job?     @relation(fields: [lastJobId], references: [id], onDelete: SetNull)

  @@unique([analysisId, version, type])
}

model Finding {
  id                   String       @id @default(cuid())
  analysisId           String
  type                 FindingType
  severity             Severity?
  detail               String?
  state                FindingState @default(new)
  relatedAnalysisId    String? // duplicate findings: the other article
  recommendedPrimaryId String? // duplicate findings: which absorbs the other
  brokenUrl            String? // plain string, malformed links must be storable
  lastJobId            String?
  createdAt            DateTime     @default(now())

  analysis           Analysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  relatedAnalysis    Analysis?  @relation("FindingRelated", fields: [relatedAnalysisId], references: [id], onDelete: SetNull)
  recommendedPrimary Analysis?  @relation("FindingPrimary", fields: [recommendedPrimaryId], references: [id], onDelete: SetNull)
  lastJob            Job?       @relation(fields: [lastJobId], references: [id], onDelete: SetNull)
  evidence           Evidence[]

  @@index([analysisId, state])
}

/// Join between Finding and Incident, carrying its own payload.
model Evidence {
  id                 String  @id @default(cuid())
  findingId          String
  incidentId         String
  newInformation     String?
  contradictsArticle Boolean @default(false)

  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([findingId, incidentId])
}

model Product {
  id                  String       @id @default(cuid())
  name                String       @unique
  aliases             String       @default("") // comma-separated
  type                ProductType?
  articleCount        Int          @default(0) // maintained counter for dashboard tiles
  dedicatedAnalysisId String? // set = has a dedicated article

  dedicatedAnalysis Analysis? @relation("ProductDedicated", fields: [dedicatedAnalysisId], references: [id], onDelete: SetNull)
  mentions          Mention[]
}

model Mention {
  id           String @id @default(cuid())
  analysisId   String
  productId    String
  mentionCount Int    @default(1)

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([analysisId, productId])
}

model Job {
  id                String    @id @default(cuid())
  status            JobStatus @default(pending)
  startedAt         DateTime?
  completedAt       DateTime?
  articlesTotal     Int       @default(0)
  articlesProcessed Int       @default(0)
  articlesSkipped   Int       @default(0)
  findingsGenerated Int       @default(0)
  duplicatesFound   Int       @default(0)
  brokenLinksFound  Int       @default(0)
  remainingBatches  Int       @default(0)
  errorMessage      String? // batch-level failure only
  scope             String?
  createdAt         DateTime  @default(now())

  items           JobItem[]
  lastJobAnalyses Analysis[] @relation("AnalysisLastJob")
  snapshots       Snapshot[]
  findings        Finding[]
}

/// One row per (job, article): the real per-article pipeline status.
model JobItem {
  id          String        @id @default(cuid())
  jobId       String
  articleId   String
  analysisId  String?
  status      JobItemStatus @default(pending)
  batchNumber Int           @default(0)
  message     String?
  updatedAt   DateTime      @updatedAt

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  article  Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)

  @@unique([jobId, articleId])
  @@index([jobId, status])
}

/// LLM prompts as data. `template` uses {{var}} placeholders.
model PromptTemplate {
  id        String   @id @default(cuid())
  name      String   @unique
  template  String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Chat comparison: ask one question against original and refined content
// ---------------------------------------------------------------------------

enum ChunkVariant {
  original
  refined
}

enum ArmStatus {
  pending
  running
  completed
  failed
}

enum Verdict {
  original
  refined
  tie
  neither
}

/// A searchable piece of an article, in one variant. Embeddings are written with raw SQL.
model Chunk {
  id        String                      @id @default(cuid())
  articleId String
  variant   ChunkVariant
  ord       Int
  heading   String?
  content   String
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, variant, ord])
  @@index([variant])
}

/// One question asked against both variants.
model Comparison {
  id        String   @id @default(cuid())
  query     String
  verdict   Verdict?
  note      String?
  createdAt DateTime @default(now())

  arms ComparisonArm[]
}

/// The answer from one variant.
model ComparisonArm {
  id           String       @id @default(cuid())
  comparisonId String
  variant      ChunkVariant
  status       ArmStatus    @default(pending)
  answer       String?
  sources      Json         @default("[]") // [{ articleId, title, heading, score, excerpt }]
  latencyMs    Int?
  error        String?
  judge        Json? // { score, reasoning } from the auto-judge

  comparison Comparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, variant])
}
