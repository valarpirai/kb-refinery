{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c blue,green \"pnpm dev:web\" \"pnpm worker\"",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "worker": "tsx --env-file=.env scripts/worker.ts",
    "dev:web": "next dev --turbopack"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^2.12.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-trace-base": "^2.12.1",
    "@opentelemetry/sdk-trace-node": "^2.12.1",
    "@prisma/client": "^6.19.3",
    "@strands-agents/sdk": "^1.26.0",
    "@traceloop/node-server-sdk": "^0.27.0",
    "better-auth": "^1.7.26",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "next": "15.5.29",
    "node-html-parser": "^9.0.7",
    "openai": "^6.49.0",
    "papaparse": "^5.7.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.11.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
