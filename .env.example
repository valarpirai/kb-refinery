DATABASE_URL="postgresql://postgres@localhost:5432/kb_refinery?schema=public"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:4b-thinking-2507-q4_K_M"
OLLAMA_THINK="auto"
SHADOW_DATABASE_URL="postgresql://<a-superuser-role>@localhost:5432/kb_refinery_shadow?schema=public"
BETTER_AUTH_SECRET="replace-with-openssl-rand-base64-32"
ALLOW_SIGNUP="true"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# Model service for the pipeline, chat answers and agents: "ollama" (default) or "anthropic".
# Embeddings for chat search always use Ollama (OLLAMA_EMBED_MODEL), because Claude has none.
LLM_PROVIDER="ollama"
# Used when LLM_PROVIDER is "anthropic". Without a key the SDK also accepts a login from `ant auth login`.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
